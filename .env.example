# Local development and testing settings.
#   cp .env.example .env && chmod 600 .env
# Railway does not use this file: set Variables with the same names in the Railway service.
# Keep comments on their own lines; python-dotenv misreads "KEY=   # comment".

# Bot token from @BotFather (/newbot). Turn on Bot Settings -> Business Mode there too.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (ask @userinfobot). Only this account is served.
OWNER_ID=

# false = PREVIEW: replies are only shown in the logs, nothing is sent.
# true = AUTO-SEND: replies are sent to people from your account.
AUTO_SEND=false

# Claude subscription token: the sk-ant-oat... output of `claude setup-token`.
# Create it once on a computer with a browser; it is valid for 1 year.
# Treat it like a password. Paste it with an editor, on ONE line (not with echo).
# This is never an API key (sk-ant-api... is rejected).
# Leave it empty to use this machine's own `claude` login (local testing only).
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude binary. Empty = `claude` on PATH, then ~/.local/bin/claude.
CLAUDE_BIN=

# Model alias or full name (for example sonnet). Empty = the CLI default.
CLAUDE_MODEL=

# Reasoning effort: low, medium, high, xhigh or max.
CLAUDE_EFFORT=low

# Seconds to wait for one reply before the claude process is killed.
CLAUDE_TIMEOUT_SECONDS=120

# Minutes to stay silent after a usage-limit error that has no reset time.
LIMIT_COOLDOWN_MINUTES=30

# Minutes the bot stays silent in a chat after you write there yourself (0 = off).
OWNER_TAKEOVER_MINUTES=15

# Messages per chat kept as context for Claude.
HISTORY_LIMIT=30
